{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/main.tsx",
    "src/App.tsx",
    "src/vite-env.d.ts",
    "src/index.css",
    "src/components/*.ts",
    "src/components/*.tsx",
    "src/pages/**/*.ts",
    "src/pages/**/*.tsx",
    "src/layouts/*.ts",
    "src/layouts/*.tsx",
    "src/store/*.ts",
    "src/data/*.ts",
    "src/types/index.ts",
    "src/utils/index.ts"
  ]
}
